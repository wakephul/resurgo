<?xml version="1.0"?>
<!-- labwc in resurgo: tema, caratteri, e il tasto Super che apre il menu del pannello -->
<labwc_config>
  <core><gap>0</gap></core>
  <theme>
    <name>Resurgo</name>
    <cornerRadius>0</cornerRadius>
    <font place="ActiveWindow"><name>Noto Sans</name><size>10</size><weight>bold</weight></font>
    <font place="InactiveWindow"><name>Noto Sans</name><size>10</size></font>
    <font place="MenuItem"><name>Noto Sans</name><size>10</size></font>
    <font place="OnScreenDisplay"><name>Noto Sans</name><size>10</size></font>
  </theme>
  <keyboard>
    <default />
    <keybind key="Super_L" onRelease="yes"><action name="Execute" command="pkill -USR1 -f resurgo-pannello" /></keybind>
    <keybind key="A-F1"><action name="Execute" command="pkill -USR1 -f resurgo-pannello" /></keybind>
    <keybind key="W-Return"><action name="Execute" command="foot" /></keybind>
  </keyboard>
</labwc_config>
